{"ast":null,"code":"var _s = $RefreshSig$();\n// src/hooks/useChordGenerator.js\n\nimport { useState } from 'react'; // ��������� ������\nimport { allChords, chordDiagrams, keyPairs, keySignatures, SHARP, FLAT, DIM } from '../data/vocabulary';\n\n// ... ��������� TONIC, SUBDOMINANT, DOMINANT, TRANSITION_MATRIX, getChordFunction �������� ��� ��������� ...\n\nexport default function useChordGenerator() {\n  _s();\n  const [state, setState] = useState('chooseKeyNum');\n  const [key, setKey] = useState('');\n  const [selectedChords, setSelectedChords] = useState([]);\n  const [selectedSteps, setSelectedSteps] = useState([]);\n  const [forbidVtoIV, setForbidVtoIV] = useState(true);\n  const [sequenceLength, setSequenceLength] = useState(4);\n  const [sequence, setSequence] = useState([]);\n  const cadenceTypes = {\n    // ... ����������� �������� ...\n    autentic: {\n      name: '�������������',\n      templateSteps: [5, 1],\n      desc: '������������ ���������� ��������� � ������.'\n    },\n    plagal: {\n      name: '����������',\n      templateSteps: [4, 1],\n      desc: '���������� ������������ � ������.'\n    },\n    full: {\n      name: '������ �������������� ������',\n      templateSteps: [4, 5, 1],\n      desc: 'SDT'\n    },\n    interrupted: {\n      name: '����������',\n      templateSteps: [5, 6],\n      desc: '�������� ���������� � ������, �� ���� � VI.'\n    },\n    dominant: {\n      name: '������������',\n      templateSteps: [5],\n      desc: '���������� �� ������� ���������, ��������� ����������.'\n    },\n    leading: {\n      name: '�������',\n      templateSteps: [7, 1],\n      desc: '���������� � VII �������, ����������� � ������.'\n    }\n  };\n\n  /**\r\n   * ������� ��������� ������������������.\r\n   * ���������� ������ ����� ��� ����������� ������ �������.\r\n   */\n  const generateSequence = () => {\n    if (!key || selectedChords.length === 0) return;\n    let sequenceChords = [];\n    let currentStep = null;\n    while (sequenceChords.length