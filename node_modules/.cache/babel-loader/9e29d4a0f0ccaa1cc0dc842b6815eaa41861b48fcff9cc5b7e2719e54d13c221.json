���� � ������.' },\r\n    full: { name: '������ �������������� ������', templateSteps: [4, 5, 1], desc: 'SDT' },\r\n    interrupted: { name: '����������', templateSteps: [5, 6], desc: '�������� ���������� � ������, �� ���� � VI.' },\r\n    dominant: { name: '������������', templateSteps: [5], desc: '���������� �� ������� ���������, ��������� ����������.' },\r\n    leading: { name: '�������', templateSteps: [7, 1], desc: '���������� � VII �������, ����������� � ������.' },\r\n  };\r\n\r\n  /**\r\n   * ������� ��������� ������������������.\r\n   * ���������� ������ ����� ��� ����������� ������ �������.\r\n   */\r\n  const generateSequence = () => {\r\n    if (!key || selectedChords.length === 0) return;\r\n\r\n    let sequenceChords = [];\r\n    let currentStep = null;\r\n\r\n    while (sequenceChords.length < sequenceLength) {\r\n      const nextItem = chooseNextChord(currentStep, selectedChords, selectedSteps, forbidVtoIV);\r\n      if (!nextItem) break; // ���� ���������� ���, ��������� ����\r\n\r\n      sequenceChords.push(nextItem.chord);\r\n      currentStep = nextItem.step;\r\n    }\r\n\r\n    // --- ���������� ������� ---\r\n    if (forbidVtoIV && canApplyCadence(selectedSteps)) {\r\n      const randomCadenceName = Object.keys(cadenceTypes)[Math.floor(Math.random() * Object.keys(cadenceTypes).length)];\r\n      const cadenceInfo = cadenceTypes[randomCadenceName];\r\n\r\n      // �������� ��������� ������� �� ����� �������\r\n      sequenceChords.splice(-cadenceInfo.templateSteps.length);\r\n\r\n      cadenceInfo.templateSteps.forEach(stepNum => {\r\n        const indexInSelected = selectedSteps.indexOf(stepNum);\r\n        if (indexInSelected !== -1) {\r\n          sequenceChords.push(selectedChords[indexInSelected]);\r\n        }\r\n      });\r\n    }\r\n\r\n    setSequence(sequenceChords);\r\n    setState('askRepeat'); // ��������� ����� ���������\r\n  };\r\n\r\n  /**\r\n   * ��������������� ������� ��� �������� ����������� ���������� �������\r\n   */\r\n  const canApplyCadence = (steps) => {\r\n    return Object.values(cadenceTypes).some(cadence =>\r\n      cadence.templateSteps.every(step => steps.includes(step))\r\n    );\r\n  };\r\n\r\n  /**\r\n   * �������� ������ ��������� ����� ������������\r\n   */\r\n  const handleInput = (userInput) => {\r\n    switch (state) {\r\n      case 'chooseKeyNum':\r\n        // ������ ������ �����������...\r\n        console.log(\"������� �����������:\", userInput);\r\n        // ��� ����� ������ ��������� ������\r\n        setState('chooseChords');\r\n        break;\r\n\r\n      case 'chooseChords':\r\n        // ������ ���������� ������������������\r\n        generateSequence();\r\n        break;\r\n\r\n      default:\r\n        console.log(`Unhandled state: ${state} with input: ${userInput}`);\r\n    }\r\n  };\r\n\r\n  return {\r\n    state,\r\n    key,\r\n    sequence,\r\n    sequenceLength,\r\n    forbidVtoIV,\r\n    handleInput,\r\n  };\r\n}"],"mappings":";AAAA;;AAEA,SAASA,QAAQ,QAAQ,OAAO,CAAC,CAAC;AAClC,SAASC,SAAS,EAAEC,aAAa,EAAEC,QAAQ,EAAEC,aAAa,EAAEC,KAAK,EAAEC,IAAI,EAAEC,GAAG,QAAQ,oBAAoB;;AAExG;;AAEA,eAAe,SAASC,iBAAiBA,CAAA,EAAG;EAAAC,EAAA;EAC1C,MAAM,CAACC,KAAK,EAAEC,QAAQ,CAAC,GAAGX,QAAQ,CAAC,cAAc,CAAC;EAElD,MAAM,CAACY,GAAG,EAAEC,MAAM,CAAC,GAAGb,QAAQ,CAAC,EAAE,CAAC;EAClC,MAAM,CAACc,cAAc,EAAEC,iBAAiB,CAAC,GAAGf,QAAQ,CAAC,EAAE,CAAC;EACxD,MAAM,CAACgB,aAAa,EAAEC,gBAAgB,CAAC,GAAGjB,QAAQ,CAAC,EAAE,CAAC;EACtD,MAAM,CAACkB,WAAW,EAAEC,cAAc,CAAC,GAAGnB,QAAQ,CAAC,IAAI,CAAC;EACpD,MAAM,CAACoB,cAAc,EAAEC,iBAAiB,CAAC,GAAGrB,QAAQ,CAAC,CAAC,CAAC;EACvD,MAAM,CAACsB,QAAQ,EAAEC,WAAW,CAAC,GAAGvB,QAAQ,CAAC,EAAE,CAAC;EAE5C,MAAMwB,YAAY,GAAG;IACnB;IACAC,QAAQ,EAAE;MAAEC,IAAI,EAAE,eAAe;MAAEC,aAAa,EAAE,CAAC,CAAC,EAAE,CAAC,CAAC;MAAEC,IAAI,EAAE;IAA8C,CAAC;IAC/GC,MAAM,EAAE;MAAEH,IAAI,EAAE,YAAY;MAAEC,aAAa,EAAE,CAAC,CAAC,EAAE,CAAC,CAAC;MAAEC,IAAI,EAAE;IAAoC,CAAC;IAChGE,IAAI,EAAE;MAAEJ,IAAI,EAAE,8BAA8B;MAAEC,aAAa,EAAE,CAAC,CAAC,EAAE,CAAC,EAAE,CAAC,CAAC;MAAEC,IAAI,EAAE;IAAM,CAAC;IACrFG,WAAW,EAAE;MAAEL,IAAI,EAA