name: '�������������', templateSteps: [5, 1], desc: '������������ ���������� ��������� � ������.' },\r\n    plagal: { name: '����������', templateSteps: [4, 1], desc: '���������� ������������ � ������.' },\r\n    full: { name: '������ �������������� ������', templateSteps: [4, 5, 1], desc: 'SDT' },\r\n    interrupted: { name: '����������', templateSteps: [5, 6], desc: '�������� ���������� � ������, �� ���� � ������ ������, ������ � VI.' },\r\n    dominant: { name: '������������', templateSteps: [5], desc: '���������� �� ������� ���������, ��������� ����������.' },\r\n    leading: { name: '�������', templateSteps: [7, 1], desc: '���������� � ������� VII �������, ����������� � ������.' },\r\n  };\r\n\r\n  // ��������������� ������� ��� ��������� ���������� �������\r\n  const chooseNextChord = (prevStep) => {\r\n    if (!selectedChords.length || !selectedSteps.length) return null;\r\n\r\n    if (prevStep === null) {\r\n      const idx = Math.floor(Math.random() * selectedChords.length);\r\n      return { chord: selectedChords[idx], step: selectedSteps[idx] };\r\n    }\r\n\r\n    const prevFunction = getChordFunction(prevStep);\r\n    if (!prevFunction) return null;\r\n\r\n    let candidates = [];\r\n    selectedSteps.forEach((step, idx) => {\r\n      const stepFunction = getChordFunction(step);\r\n      let weight = TRANSITION_MATRIX[prevFunction][stepFunction] || 0;\r\n\r\n      // ������ V -> IV\r\n      if (forbidVtoIV && prevFunction === DOMINANT && stepFunction === SUBDOMINANT) {\r\n        weight = 0;\r\n      }\r\n\r\n      for (let i = 0; i < weight; i++) candidates.push(idx);\r\n    });\r\n\r\n    if (candidates.length === 0) return null;\r\n\r\n    const chosenIdx = candidates[Math.floor(Math.random() * candidates.length)];\r\n    return {\r\n      chord: selectedChords[chosenIdx],\r\n      step: selectedSteps[chosenIdx],\r\n    };\r\n  };\r\n\r\n  // ������� �������� ����������� ��������� ������\r\n  const canApplyCadence = () => {\r\n    return Object.values(cadenceTypes).some(cadence =>\r\n      cadence.templateSteps.every(step => selectedSteps.includes(step))\r\n    );\r\n  };\r\n\r\n  // �������� ������ ��������� ������������������\r\n  const generateSequence = () => {\r\n    if (!key || !selectedChords.length) return;\r\n\r\n    let sequenceChords = [];\r\n    let currentStep = null;\r\n\r\n    while (sequenceChords.length < sequenceLength) {\r\n      const nextItem = chooseNextChord(currentStep);\r\n      if (!nextItem) break;\r\n\r\n      sequenceChords.push(nextItem.chord);\r\n      currentStep = nextItem.step;\r\n    }\r\n\r\n    // --- ���������� ������� ---\r\n    if (forbidVtoIV && canApplyCadence()) {\r\n      const randomCadenceName = Object.keys(cadenceTypes)[Math.floor(Math.random() * Object.keys(cadenceTypes).length)];\r\n      const cadenceInfo = cadenceTypes[randomCadenceName];\r\n\r\n      // �������� ��������� ������� �� ����� �������\r\n      sequenceChords.splice(-cadenceInfo.templateSteps.length);\r\n\r\n      cadenceInfo.templateSteps.forEach(stepNum => {\r\n        const indexInSelected = selectedSteps.indexOf(stepNum);\r\n        if (indexInSelected !== -1) {\r\n          sequenceChords.push(selectedChords[indexInSelected]);\r\n        }\r\n      });\r\n    }\r\n\r\n    setSequence(sequenceChords);\r\n    setState('askRepeat'); // ��������� ����� ���������\r\n  };\r\n\r\n  // ���������� ����� ������������\r\n  const handleInput = (userInput) => {\r\n    switch (state) {\r\n      case 'chooseKeyNum':\r\n        // ������ ������ �����������...\r\n        console.log(\"������� �����������:\", userInput);\r\n        // ��� ����� ������ ��������� ������\r\n        setState('chooseChords');\r\n        break;\r\n\r\n      case 'chooseChords':\r\n        // ������ ���������� ������������������\r\n        generateSequence();\r\n        break;\r\n\r\n      case 'askVtoIV':\r\n        setForbidVtoIV(userInput !== '2' && userInput !== '���');\r\n        setState('askCount');\r\n        break;\r\n\r\n    