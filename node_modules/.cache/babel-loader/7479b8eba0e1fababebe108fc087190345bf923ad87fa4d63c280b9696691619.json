{"ast":null,"code":"var _s = $RefreshSig$();\n// src/hooks/useChordGenerator.js\n\nimport { useState } from 'react';\nimport { allChords, chordDiagrams, keyPairs, keySignatures, SHARP, FLAT, DIM } from '../data/vocabulary';\nconst TONIC = 'T';\nconst SUBDOMINANT = 'S';\nconst DOMINANT = 'D';\nconst TRANSITION_MATRIX = {\n  [TONIC]: {\n    [TONIC]: 1,\n    [SUBDOMINANT]: 3,\n    [DOMINANT]: 2\n  },\n  [SUBDOMINANT]: {\n    [TONIC]: 2,\n    [SUBDOMINANT]: 1,\n    [DOMINANT]: 4\n  },\n  [DOMINANT]: {\n    [TONIC]: 5,\n    [SUBDOMINANT]: 1,\n    [DOMINANT]: 1\n  }\n};\nfunction getChordFunction(step) {\n  if ([1, 3, 6].includes(step)) return TONIC;\n  if ([2, 4].includes(step)) return SUBDOMINANT;\n  if ([5, 7].includes(step)) return DOMINANT;\n  return null;\n}\nexport default function useChordGenerator() {\n  _s();\n  const [state, setState] = useState('chooseKeyNum');\n  const [key, setKey] = useState('');\n  const [selectedChords, setSelectedChords] = useState([]);\n  const [selectedSteps, setSelectedSteps] = useState([]);\n  const [forbidVtoIV, setForbidVtoIV] = useState(true);\n  const [sequenceLength, setSequenceLength] = useState(4);\n  const [sequence, setSequence] = useState([]);\n  const cadenceTypes = {\n    autentic: {\n      name: '�������������',\n      templateSteps: [5, 1],\n      desc: '������������ ���������� ��������� � ������.'\n    },\n    plagal: {\n      name: '����������',\n      templateSteps: [4, 1],\n      desc: '���������� ������������ � ������.'\n    },\n    full: {\n      name: '������ �������������� ������',\n      templateSteps: [4, 5, 1],\n      desc: 'SDT'\n    },\n    interrupted: {\n      name: '����������',\n      templateSteps: [5, 6],\n      desc: '�������� ���������� � ������, �� ���� � ������ ������, ������ � VI.'\n    },\n    dominant: {\n      name: '������������',\n      templateSteps: [5],\n      desc: '���������� �� ������� ���������, ��������� ����������.'\n    },\n    leading: {\n      name: '�������',\n      templateSteps: [7, 1],\n      desc: '���������� � ������� VII �������, ����������� � ������.'\n    }\n  };\n\n  // ��������������� ������� ��� ��������� ���������� �������\n  const chooseNextChord = prevStep => {\n    if (!selectedChords.length || !selectedSteps.length) return null;\n    if (prevStep === null) {\n      const idx = Math.floor(Math.random() * selectedChords.length);\n      return {\n        chord: selectedChords[idx],\n        step: selectedSteps[idx]\n      };\n    }\n    const prevFunction = getChordFunction(prevStep);\n    if (!prevFunction) return null;\n    let candidates = [];\n    selectedSteps.forEach((step, idx) => {\n      const stepFunction = getChordFunction(step);\n      let weight = TRANSITION_MATRIX[prevFunction][stepFunction] || 0;\n\n      // ������ V -> IV\n      if (forbidVtoIV && prevFunction === DOMINANT && stepFunction === SUBDOMINANT) {\n        weight = 0;\n      }\n      for (let i = 0; i < weight; i++) candidates.push(idx);\n    });\n    if (candidates.length === 0) return null;\n    const chosenIdx = candidates[Math.floor(Math.random() * candidates.length)];\n    return {\n      chord: selectedChords[chosenIdx],\n      step: selectedSteps[chosenIdx]\n    };\n  };\n\n  // ������� �������� ����������� ��������� ������\n  const canApplyCadence = () => {\n    return Object.values(cadenceTypes).some(cadence => cadence.templateSteps.every(step => selectedSteps.includes(step)));\n  };\n\n  // �������� ������ ��������� ������������������\n  const generateSequence = () => {\n    if (!key || !selectedChords.length) return;\n    let sequenceChords = [];\n    let currentStep = null;\n    while (sequenceChords.length < sequenceLength) {\n      const nextItem = chooseNextChord(currentStep);\n      if (!nextItem) break;\n      sequenceChords.push(nextItem.chord);\n      currentStep = nextItem.step;\n    }\n\n    // --- ���������� ������� ---\n    if (forbidVtoIV && canApplyCadence()) {\n      const randomCadenceName = Object.keys(cadenceTypes)[Math.floor(Math.random() * Object.keys(cadenceTypes).length)];\n      const cadenceInfo = cadenceTypes[randomCadenceName];\n\n      // �������� ��������� ������� �� ����� �������\n      sequenceChords.splice(-cadenceInfo.templateSteps.length);\n      cadenceInfo.templateSteps.forEach(stepNum => {\n        const indexInSelected = selectedSteps.indexOf(stepNum);\n        if (indexInSelected !== -1) {\n          sequenceChords.push(selectedChords[indexInSelected]);\n        }\n      });\n    }\n    setSequence(sequenceChords);\n    setState('askRepeat'); // ��������� ����� ���������\n  };\n\n  // ���������� ����� ������������\n  const handleInput = userInput => {\n    switch (state) {\n      case 'chooseKeyNum':\n        // ������ ������ �����������...\n        console.log(\"������� �����������:\", userInput);\n        // ��� ����� ������ ��������� ������\n        setState('chooseChords');\n        break;\n      case 'chooseChords':\n        // ������ ���������� ������������������\n        generateSequence();\n        break;\n      case 'askVtoIV':\n        setForbidVtoIV(userInput !== '2' && userInput !== '���');\n        setState('askCount');\n        break;\n      case 'askCount':\n        const num = parseInt(userInput);\n        if (!isNaN(num) && num >= 3) setSequenceLength(num);\n        generateSequence(); // ��������� ����� ��������� �����\n        break;\n      default:\n        console.log(`Unhandled state: ${state} with input: ${userInput}`);\n    }\n  };\n  return {\n    state,\n    key,\n    sequence,\n    sequenceLength,\n    forbidVtoIV,\n    handleInput\n  };\n}\n_s(useChordGenerator, \"Pw7saOWgk+Eh1B7VQi6x/LsTODs=\");","map":{"version":3,"names":["useState","allChords","chordDiagrams","keyPairs","keySignatures","SHARP","FLAT","DIM","TONIC","SUBDOMINANT","DOMINANT","TRANSITION_MATRIX","getChordFunction","step","includes","useChordGenerator","_s","state","setState","key","setKey","selectedChords","setSelectedChords","selectedSteps","setSelectedSteps","forbidVt