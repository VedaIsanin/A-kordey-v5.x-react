r\n  const [key, setKey] = useState('');\r\n  const [selectedChords, setSelectedChords] = useState([]);\r\n  const [selectedSteps, setSelectedSteps] = useState([]);\r\n\r\n  const [forbidVtoIV, setForbidVtoIV] = useState(true);\r\n  const [sequenceLength, setSequenceLength] = useState(4);\r\n\r\n  const [sequence, setSequence] = useState([]);\r\n\r\n  const cadenceTypes = {\r\n    // ... (����������� �������� �� vocabulary)\r\n    // ������:\r\n    // 'autentic': { name: '�������������', templateSteps: [5,1] },\r\n    // 'plagal': { name: '����������', templateSteps: [4,1] },\r\n    // � �.�.\r\n    // ��� �������� ������� ����� ������������ ������ ������������� ������.\r\n    'autentic': { name: '�������������', templateSteps: [5,1] },\r\n    'plagal': { name: '����������', templateSteps: [4,1] },\r\n    'full': { name: '������ �������������� ������', templateSteps: [4,5,1] },\r\n    'interrupted': { name: '����������', templateSteps: [5,6] },\r\n    'dominant': { name: '������������', templateSteps: [5] },\r\n    'leading': { name: '�������', templateSteps: [7,1] },\r\n  };\r\n\r\n  function handleInput(userInput) {\r\n    switch (state) {\r\n      case 'chooseKeyNum':\r\n        // ������ ������ �����������...\r\n        break;\r\n      case 'chooseKeyType':\r\n        // ������ ������ �����/�����...\r\n        break;\r\n      case 'chooseChords':\r\n        // ������ �������� ��������� ��������...\r\n        break;\r\n      case 'askVtoIV':\r\n        setForbidVtoIV(userInput !== '2' && userInput !== '���');\r\n        setState('askCount');\r\n        break;\r\n      case 'askCount':\r\n        const num = parseInt(userInput);\r\n        if (!isNaN(num) && num >=3) setSequenceLength(num);\r\n        generateSequence();\r\n        break;\r\n      default:\r\n        break;\r\n    }\r\n    // ���������� ���� ������ handleInput �� ������ ����...\r\n    // ��� ����� �������� ����� ������������.\r\n    // ��� ��������� ������� �������� ����� � ������� ���������.\r\n    // � �������� ������� ������ ���� ����� ����������.\r\n    console.log('Input:', userInput);\r\n    console.log('Current State:', state);\r\n    \r\n    // --- ������ ������� ��������� ---\r\n    if (userInput === '00') {\r\n      const randomIdx = Math.floor(Math.random() * keyPairs.length);\r\n      const randomMode = Math.round(Math.random());\r\n      setKey(keyPairs[randomIdx][randomMode]);\r\n      setSelectedChords(allChords[keyPairs[randomIdx][randomMode]].slice());\r\n      setSelectedSteps([1,2,3,4,5,6,7]);\r\n      setSequenceLength(4);\r\n      generateSequence();\r\n    }\r\n    \r\n    if (userInput === 'generate') {\r\n      generateSequence();\r\n    }\r\n    \r\n    if (userInput === 'reset') {\r\n      setSequence([]);\r\n      setState('chooseKeyNum');\r\n    }\r\n    \r\n    if (userInput === '0') {\r\n      const chordsInKey = allChords[key];\r\n      setSelectedChords(chordsInKey.slice());\r\n      setSelectedSteps([1,2,3,4,5,6,7]);\r\n      generateSequence();\r\n    }\r\n    \r\n    if (userInput === '') {\r\n      const chordsInKey = allChords[key];\r\n      const dimStep = key.includes('-dur') ? 7 : 2;\r\n      const filteredSteps = [1,2,3,4,5,6,7].filter(i => i !== dimStep);\r\n      \r\n      setSelectedChords(filteredSteps.map(i => chordsInKey[i-1]));\r\n      setSelectedSteps(filteredSteps);\r\n      generateSequence();\r\n    }\r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n    \r\n\r\n\r\n}\r\n\r\nfunction generateSequence() {\r\n  let sequenceChords = [];\r\n  let sequenceStepsArr = [];\r\n  \r\n  let currentStep = null;\r\n  \r\n  while (sequenceChords.length < sequenceLength) {\r\n    const nextItem = chooseNextChord(currentStep, selectedChords, selectedSteps, forbidVtoIV);\r\n    if (!nextItem) break;\r\n\r\n    sequenceChords.push(nextItem.chord);\r\n    sequenceStepsArr.push(nextItem.step);\r\n    currentStep = nextItem.step;\r\n  }\r\n  \r\n  \r\n  \r\n  \r\n  \r\n  \r\n  \r\n  \r\n  \r\n  \r\n  \r\n  \r\n  \r\n  \r\n  \r\n  \r\n  \r\n  \r\n  \r\n  \r\n  \r\n  \r\n\r\n\r\n\r\n// --- ���������� ������� ---\r\n// ���������, ����� �� ��������� ������ (���� �� � selectedSteps ���� ��� ����)\r\nconst canApplyCadence = Object.values(cadenceTypes).some(cadence =>\r\n   cadence.templateSteps.every(step => selectedSteps.includes(step))\r\n);\r\n\r\nif (forbidVtoIV && canApplyCadence) {\r\n   // �������� ��������� ������ � ��������� ��� � �����\r\n   const cadenceNames = Object.keys(cadenceTypes);\r\n   const randomCadenceName = cadenceNames[Math.floor(Math.random() * cadenceNames.length)];\r\n   const cadenceInfo = cadenceTypes[randomCadenceName];\r\n   \r\n   // �������� ��������� ������� �� ����� ������� � �������� �� �� ����������\r\n   sequenceChords.splice(-cadenceInfo.templateSteps.length);\r\n   sequenceStepsArr.splice(-cadenceInfo.templateSteps.length);\r\n   \r\n   cadenceInfo.templateSteps.forEach(stepNum => {\r\n     const indexInSelected = selectedSteps.indexOf(stepNum);\r\n     if (indexInSelected !== -1) {\r\n       sequenceChords.push(selectedChords[indexInSelected]);\r\n       sequenceStepsArr.push(stepNum);\r\n     }\r\n   });\r\n}\r\n\r\n\r\nsetSequence(sequenceChords);\r\nsetState('askRepeat'); // ��������� ����� ���������\r\n\r\n}\r\n\r\n\r\nreturn {\r\n   state,\r\n   key,\r\n   sequence,\r\n   sequenceLength,\r\n   forbidVtoIV,\r\n   handleInput,\r\n};\r\n}"],"mappings":";AAAA;;AAEA,SAASA,QAAQ,QAAQ,OAAO;AAChC,SAASC,SAAS,EAAEC,aAAa,EAAEC,QAAQ,EAAEC,aAAa,QAAQ,oBAAoB;AAEtF,MAAMC,KAAK,GAAG,GAAG;AACjB,MAAMC,WAAW,GAAG,GAAG;AACvB,MAAMC,QAAQ,GAAG,GAAG;AAEpB,MAAMC,iBAAiB,GAAG;EACxB,CAACH,KAAK,GAAG;IAAE,CAACA,KAAK,GAAG,CAAC;IAAE,CAACC,WAAW,GAAG,CAAC;IAAE,CAACC,QAAQ,GAAG;EAAE,CAAC;EACxD,CAACD,WAAW,GAAG;IAAE,CAACD,KAAK,GA