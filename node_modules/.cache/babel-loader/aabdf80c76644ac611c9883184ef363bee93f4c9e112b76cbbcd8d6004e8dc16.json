{"ast":null,"code":"var _s = $RefreshSig$();\n// src/hooks/useChordGenerator.js\n\nimport { useState } from 'react';\nimport { allChords, chordDiagrams, keyPairs, keySignatures } from '../data/vocabulary';\nconst TONIC = 'T';\nconst SUBDOMINANT = 'S';\nconst DOMINANT = 'D';\nconst TRANSITION_MATRIX = {\n  [TONIC]: {\n    [TONIC]: 1,\n    [SUBDOMINANT]: 3,\n    [DOMINANT]: 2\n  },\n  [SUBDOMINANT]: {\n    [TONIC]: 2,\n    [SUBDOMINANT]: 1,\n    [DOMINANT]: 4\n  },\n  [DOMINANT]: {\n    [TONIC]: 5,\n    [SUBDOMINANT]: 1,\n    [DOMINANT]: 1\n  }\n};\nfunction getChordFunction(step) {\n  if ([1, 3, 6].includes(step)) return TONIC;\n  if ([2, 4].includes(step)) return SUBDOMINANT;\n  if ([5, 7].includes(step)) return DOMINANT;\n  return null;\n}\nfunction chooseNextChord(prevStep, selectedChords, selectedSteps, forbidVtoIV) {\n  if (!prevStep) {\n    const idx = Math.floor(Math.random() * selectedChords.length);\n    return {\n      chord: selectedChords[idx],\n      step: selectedSteps[idx]\n    };\n  }\n  const prevFunction = getChordFunction(prevStep);\n  if (!prevFunction) return null;\n  const weightsForTransition = TRANSITION_MATRIX[prevFunction];\n  let candidates = [];\n  selectedSteps.forEach((step, idx) => {\n    const stepFunction = getChordFunction(step);\n    let weight = weightsForTransition[stepFunction] || 0;\n\n    // ������ V -> IV\n    if (forbidVtoIV && prevFunction === DOMINANT && stepFunction === SUBDOMINANT) {\n      weight = 0;\n    }\n    for (let i = 0; i < weight; i++) candidates.push(idx);\n  });\n  if (candidates.length === 0) return null;\n  const chosenIdx = candidates[Math.floor(Math.random() * candidates.length)];\n  return {\n    chord: selectedChords[chosenIdx],\n    step: selectedSteps[chosenIdx]\n  };\n}\nexport default function useChordGenerator() {\n  _s();\n  const [state, setState] = useState('chooseKeyNum');\n  const [key, setKey] = useState('');\n  const [selectedChords, setSelectedChords] = useState([]);\n  const [selectedSteps, setSelectedSteps] = useState([]);\n  const [forbidVtoIV, setForbidVtoIV] = useState(true);\n  const [sequenceLength, setSequenceLength] = useState(4);\n  const [sequence, setSequence] = useState([]);\n  const cadenceTypes = {\n    // ... (����������� �������� �� vocabulary)\n    // ������:\n    // 'autentic': { name: '�������������', templateSteps: [5,1] },\n    // 'plagal': { name: '����������', templateSteps: [4,1] },\n    // � �.�.\n    // ��� �������� ������� ����� ������������ ������ ������������� ������.\n    'autentic': {\n      name: '�������������',\n      templateSteps: [5, 1]\n    },\n    'plagal': {\n      name: '����������',\n      templateSteps: [4, 1]\n    },\n    'full': {\n      name: '������ �������������� ������',\n      templateSteps: [4, 5, 1]\n    },\n    'interrupted': {\n      name: '����������',\n      templateSteps: [5, 6]\n    },\n    'dominant': {\n      name: '������������',\n      templateSteps: [5]\n    },\n    'leading': {\n      name: '�������',\n      templateSteps: [7, 1]\n    }\n  };\n  function handleInput(userInput) {\n    switch (state) {\n      case 'chooseKeyNum':\n        // ������ ������ �����������...\n        break;\n      case 'chooseKeyType':\n        // ������ ������ �����/�����...\n        break;\n      case 'chooseChords':\n        // ������ �������� ��������� ��������...\n        break;\n      case 'askVtoIV':\n        setForbidVtoIV(userInput !== '2' && userInput !== '���');\n        setState('askCount');\n        break;\n      case 'askCount':\n        const num = parseInt(userInput);\n        if (!isNaN(num) && num >= 3) setSequenceLength(num);\n        generateSequence();\n        break;\n      default:\n        break;\n    }\n    // ���������� ���� ������ handleInput �� ������ ����...\n    // ��� ����� �������� ����� ������������.\n    // ��� ��������� ������� �������� ����� � ������� ���������.\n    // � �������� ������� ������ ���� ����� ����������.\n    console.log('Input:', userInput);\n    console.log('Current State:', state);\n\n    // --- ������ ������� ��������� ---\n    if (userInput === '00') {\n      const randomIdx = Math.floor(Math.random() * keyPairs.length);\n      const randomMode = Math.round(Math.random());\n      setKey(keyPairs[randomIdx][randomMode]);\n      setSelectedChords(allChords[keyPairs[randomIdx][randomMode]].slice());\n      setSelectedSteps([1, 2, 3, 4, 5, 6, 7]);\n      setSequenceLength(4);\n      generateSequence();\n    }\n    if (userInput === 'generate') {\n      generateSequence();\n    }\n    if (userInput === 'reset') {\n      setSequence([]);\n      setState('chooseKeyNum');\n    }\n    if (userInput === '0') {\n      const chordsInKey = allChords[key];\n      setSelectedChords(chordsInKey.slice());\n      setSelectedSteps([1, 2, 3, 4, 5, 6, 7]);\n      generateSequence();\n    }\n    if (userInput === '') {\n      const chordsInKey = allChords[key];\n      const dimStep = key.includes('-dur') ? 7 : 2;\n      const filteredSteps = [1, 2, 3, 4, 5, 6, 7].filter(i => i !== dimStep);\n      setSelectedChords(filteredSteps.map(i => chordsInKey[i - 1]));\n      setSelectedSteps(filteredSteps);\n      generateSequence();\n    }\n  }\n  function generateSequence() {\n    let sequenceChords = [];\n    let sequenceStepsArr = [];\n    let currentStep = null;\n    while (sequenceChords.length < sequenceLength) {\n      const nextItem = chooseNextChord(currentStep, selectedChords, selectedSteps, forbidVtoIV);\n      if (!nextItem) break;\n      sequenceChords.push(nextItem.chord);\n      sequenceStepsArr.push(nextItem.step);\n      currentStep = nextItem.step;\n    }\n\n    // --- ���������� ������� ---\n    // ���������, ����� �� ��������� ������ (���� �� � selectedSteps ���� ��� ����)\n    const canApplyCadence = Object.values(cadenceTypes).some(cadence => cadence.templateSteps.every(step => selectedSteps.includes(step)));\n    if (forbidVtoIV && canApplyCadence) {\n      // �������� ��������� ������ � ��������� ��� � �����\n      const cadenceNames = Object.keys(cadenceTypes);\n      const randomCadenceName = cadenceNames[Math.floor(Math.random() * cadenceNames.length)];\n      const cadenceInfo = cadenceTypes[randomCadenceName];\n\n      // �������� ��������� ������� �� ����� ������� � �������� �� �� ����������\n      sequenceChords.splice(-cadenceInfo.templateSteps.length);\n      sequenceStepsArr.splice(-cadenceInfo.templateSteps.length);\n      cadenceInfo.templateSteps.forEach(stepNum => {\n        const indexInSelected = selectedSteps.indexOf(stepNum);\n        if (indexInSelected !== -1) {\n          sequenceChords.push(selectedChords[indexInSelected]);\n          sequenceStepsArr.push(stepNum);\n        }\n      });\n    }\n    setSequence(sequenceChords);\n    setState('askRepeat'); // ��������� ����� ���������\n  }\n  return {\n    state,\n    key,\n    sequence,\n    sequenceLength,\n    forbidVtoIV,\n    handleInput\n  };\n}\n_s(useChordGenerator, \"Pw7saOWgk+Eh1B7VQi6x/LsTODs=\");","map":{"version":3,"names":["useState","allChords","chordDiagrams","keyPairs","keySignatures","TONIC","SUBDOMINANT","DOMINANT","TRANSITION_MATRIX","getChordFunction","step","includes","chooseNextChord","prevStep","selectedChords","selectedSteps","forbidVtoIV","idx","Math","floor","random","length","chord","prevFunction","weightsForTransition","candidates","forEach","stepFunction","weight","i","push","chosenIdx","useChordGenerator","_s","state","setState","key","setKey","setSelectedChords","setSelectedSteps","setForbidVtoIV","sequenceLength","setSequenceLength","sequence","setSequence","cadenceTypes","name","templateSteps","handleInput","userInput","num","parseInt","isNaN","generateSequence","console","log","randomIdx","randomMode","round","slice","chordsInKey","dimStep","filteredSteps","filter","map","sequenceChords","sequenceStepsArr","currentStep","nextItem","canApplyCadence","Object","values","some","cadence","every","cadenceNames","keys","randomCadenceName","cadenceInfo","splice","stepNum","indexInSelecte